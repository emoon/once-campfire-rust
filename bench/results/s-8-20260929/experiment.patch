diff --git a/crates/db/src/database.rs b/crates/db/src/database.rs
index 3495a0e..e135674 100644
--- a/crates/db/src/database.rs
+++ b/crates/db/src/database.rs
@@ -307,6 +307,11 @@ impl Database {
         T: Send + 'static,
         F: FnOnce(&Connection) -> Result<T> + Send + 'static,
     {
+        // S-8 experiment: run reads on the calling worker instead of the blocking pool.
+        static INLINE: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var_os("S8_INLINE_READS").is_some());
+        if *INLINE {
+            return self.readers.with(f);
+        }
         let readers = self.readers.clone();
         tokio::task::spawn_blocking(move || readers.with(f))
             .await
